{
  "name": "underline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:python",
    "test:unit": "vitest run",
    "test:python": "PYTHONPATH=. python3 -m pytest -q",
    "test:fast": "npm run test:unit && PYTHONPATH=. python3 -m pytest -q -m 'not slow'",
    "test:changed": "PYTHONPATH=. python3 scripts/select_changed_tests.py",
    "tauri": "tauri",
    "agents:anchors": "PYTHONPATH=. python3 scripts/extract_anchors.py",
    "prototype:strip": "PYTHONPATH=. python3 prototype/strip-coherence/tui.py",
    "prototype:strip:smoke": "PYTHONPATH=. python3 prototype/strip-coherence/smoke.py",
    "strip:ingest": "PYTHONPATH=. python3 -m pipeline.ingest_strip",
    "strip:author": "PYTHONPATH=. python3 -m pipeline.motion_author_cli",
    "strip:polish": "PYTHONPATH=. python3 -m pipeline.final_polish_cli",
    "asset:static": "PYTHONPATH=. python3 -m pipeline.static_asset_cli",
    "asset:pack": "PYTHONPATH=. python3 -m pipeline.asset_pack_cli",
    "prototype:strip:adversarial": "PYTHONPATH=. python3 prototype/strip-coherence/adversarial.py",
    "prototype:strip:corpus": "PYTHONPATH=. python3 prototype/strip-coherence/corpus.py",
    "prototype:strip:derive-budgets": "PYTHONPATH=. python3 prototype/strip-coherence/derive_budgets.py",
    "prototype:strip:alpha-budgets": "PYTHONPATH=. python3 prototype/strip-coherence/alpha_budgets.py",
    "prototype:strip:displacement": "PYTHONPATH=. python3 prototype/strip-coherence/displacement_probe.py",
    "prototype:strip:sharpness": "PYTHONPATH=. python3 prototype/strip-coherence/alignment_sharpness.py",
    "gate-control:acquire": "PYTHONPATH=. python3 -m pipeline.gate_control_acquire",
    "gate-control:score": "PYTHONPATH=. python3 -m pipeline.gate_control",
    "gate-control:review": "PYTHONPATH=. python3 -m pipeline.gate_review",
    "gate-control:verify": "PYTHONPATH=. python3 -m pipeline.gate_verification",
    "parts:render": "PYTHONPATH=. python3 -m pipeline.parts_cli render"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "typescript": "~5.6",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
